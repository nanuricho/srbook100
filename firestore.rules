rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /students/{studentId} {
      allow read, write: if true;
    }
    match /class_passwords/{classKey} {
      allow read, write: if true;
    }
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
