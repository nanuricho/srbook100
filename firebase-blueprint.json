{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "A student profile containing their reading records and metadata",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique student identifier"
        },
        "grade": {
          "type": "string",
          "description": "Grade level e.g. 3학년"
        },
        "className": {
          "type": "string",
          "description": "Class name e.g. 1반"
        },
        "studentNumber": {
          "type": "string",
          "description": "Student attendance number e.g. 1번"
        },
        "name": {
          "type": "string",
          "description": "Student name"
        },
        "records": {
          "type": "object",
          "description": "Map of book number to ReadingRecord"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "grade", "className", "name"]
    },
    "ClassPassword": {
      "title": "ClassPassword",
      "description": "Teacher password entry for each class or master admin",
      "type": "object",
      "properties": {
        "classKey": {
          "type": "string",
          "description": "Class identifier e.g. 4학년_2반 or MASTER"
        },
        "grade": {
          "type": "string",
          "description": "Grade e.g. 4학년"
        },
        "className": {
          "type": "string",
          "description": "Class e.g. 2반"
        },
        "passwordHash": {
          "type": "string",
          "description": "Encoded password hash"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["classKey", "passwordHash"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of students with their reading progress and reviews"
    },
    "/class_passwords/{classKey}": {
      "schema": "ClassPassword",
      "description": "Collection of individual teacher passwords per class"
    }
  }
}
